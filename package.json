{
	"name": "new-todomate",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"dev:api": "bun --watch src/server/dev.ts",
		"build": "vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint .",
		"lint:fix": "biome check --write .",
		"test": "bun test",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"deploy": "bun run build && wrangler deploy",
		"deploy:migrate": "bun script/deploy/migrate.ts",
		"deploy:seed": "bun script/deploy/seed-admin.ts"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "1.7.2",
		"@electric-sql/pglite": "0.5.8",
		"@neondatabase/serverless": "1.1.0",
		"@tanstack/react-query": "5.102.8",
		"better-auth": "1.7.2",
		"drizzle-orm": "0.45.2",
		"hono": "4.13.5",
		"lucide-react": "1.39.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"zod": "4.5.4"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"@playwright/test": "1.62.1",
		"@types/bun": "1.4.0",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"@vitejs/plugin-react": "6.1.1",
		"drizzle-kit": "0.31.10",
		"typescript": "7.0.2",
		"vite": "8.2.2",
		"vite-plugin-pwa": "1.3.0",
		"wrangler": "4.128.0"
	}
}
