{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "new-todomate",
	"main": "src/server/worker.ts",
	"compatibility_date": "2026-09-02",
	"compatibility_flags": ["nodejs_compat"],
	"exports": {
		"ChatRoom": {
			"type": "durable-object",
			"storage": "sqlite"
		}
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "CHAT_ROOM",
				"class_name": "ChatRoom"
			}
		]
	},
	"workers_dev": true,
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	"observability": {
		"enabled": true
	}
}
